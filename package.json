		"@tldraw/validate": "5.6.2",
		"mammoth": "^1.13.0",
		"mermaid": "^12.3.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.5.438",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"tldraw": "5.6.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261123.1",
