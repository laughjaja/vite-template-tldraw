	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"dev:cloud": "npm run build && wrangler dev",
		"deploy:cloud": "npm run build && wrangler deploy",
		"check:worker": "tsc -p worker/tsconfig.json",
		"check": "npm run build && npm run check:worker",
		"typecheck:worker": "tsc -p worker/tsconfig.json",
		"test:cloud-sync": "node scripts/test-cloud-sync.mjs"
	},
	"dependencies": {
		"@google/genai": "^3.6.1",
