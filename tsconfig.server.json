{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"outDir": ".server-dist",
		"rootDir": ".",
		"rewriteRelativeImportExtensions": true,
		"declaration": false,
		"sourceMap": false,
		"types": [
			"node"
		]
	},
	"include": [
		"server/**/*.ts",
		"src/shared/**/*.ts",
		"src/shared/**/*.tsx",
		"vite-env.d.ts"
	]
}
