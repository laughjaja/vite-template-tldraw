{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"framework": "vite",
	"functions": {
		"api/agent/*.ts": {
			"maxDuration": 60
		}
	},
	"rewrites": [
		{ "source": "/api/(.*)", "destination": "/api/$1" },
		{ "source": "/((?!api/|assets/|favicon).*)", "destination": "/index.html" }
	]
}
